# Firebase AI Logic handles Gemini securely via App Check without any client-side API key.
# Do NOT put LLM keys (Groq/OpenAI) or Cloudflare admin tokens here; keep server secrets server-side.

# Kakao Login & Kakao Friends API keys (configure in AI Studio Secrets Panel):
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
KAKAO_REDIRECT_URI=dadquest://kakao-oauth

# Optional public Cloudflare Worker base URL (read-only vocab shard sync; mutating endpoints require server-side auth):
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Google Maps & Street View API Key (restrict by Android package + SHA-1 in Google Cloud Console):
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

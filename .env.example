# Firebase AI Logic handles Gemini without an API key.
# Kakao Login & Kakao Friends API keys (configure in AI Studio Secrets Panel):
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
KAKAO_REDIRECT_URI=dadquest://kakao-oauth

# Cloudflare Workers Level Registration Server (configure in AI Studio Secrets Panel):
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# Groq API Keys (5-Key Round-Robin Rotation for openai/gpt-oss-120b — configure in AI Studio Secrets Panel):
GROQ_API_KEY_1=YOUR_GROQ_API_KEY_1
GROQ_API_KEY_2=YOUR_GROQ_API_KEY_2
GROQ_API_KEY_3=YOUR_GROQ_API_KEY_3
GROQ_API_KEY_4=YOUR_GROQ_API_KEY_4
GROQ_API_KEY_5=YOUR_GROQ_API_KEY_5

# Google Maps & Street View API Key (for real street travel view — configure in AI Studio Secrets Panel):
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

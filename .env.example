# Cloudflare Workers + D1 + Workers AI handles cloud AI & sync without client-side admin secrets.
# Do NOT put LLM keys (Groq/OpenAI) or Cloudflare admin tokens here; keep server secrets in Cloudflare Workers (`wrangler secret put`).

# Public Cloudflare Worker base URL (deploy cloudflare-worker/ and set this in AI Studio Secrets Panel):
CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Kakao Login & Kakao Friends API keys (configure in AI Studio Secrets Panel):
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_NATIVE_APP_KEY=YOUR_KAKAO_NATIVE_APP_KEY
KAKAO_REDIRECT_URI=dadquest://kakao-oauth

# Optional Google Maps & Street View API Key (restrict by Android package + SHA-1 in Google Cloud Console):
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
